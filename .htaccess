# 快活フロンティア 発注管理システム
# Apacheルート用 .htaccess

# ディレクトリ一覧表示禁止
Options -Indexes

# 検索エンジンにインデックスさせない（社内向けツールのため検索結果に出さない）
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# デフォルトドキュメント（インデックスファイル）の指定
DirectoryIndex login.html

# 機密ファイル・ディレクトリへのアクセス拒否
<FilesMatch "^(composer\.(json|lock|phar)|\.gitignore|\.env|HANDOVER\.md|backend-spec\.md|README\.md)$">
    Require all denied
</FilesMatch>

# 機密ディレクトリへのアクセス拒否（設置パス・フォルダ名に依存しない）
# includes(=config.phpにDB接続情報) / vendor / setup / database / docs / backup / .git
RedirectMatch 403 (?i)/(\.git|database|includes|setup|vendor|docs|backup)(/|$)

# HTMLは認証ガード・フラッシュ防止の更新を確実に反映するため毎回サーバー確認
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>
